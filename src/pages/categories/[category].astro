---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { resolveCover } from '../_imageStore';
import { slugify } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = new Set<string>();
  for (const post of posts) {
    for (const cat of post.data.categories || []) {
      categories.add(cat);
    }
  }
  return Array.from(categories).map((cat) => ({
    params: { category: slugify(cat) },
    props: { categoryName: cat },
  }));
}

const { categoryName } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const filtered = allPosts
  .filter((post) => (post.data.categories || []).includes(categoryName))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postData = filtered.map((p) => ({
  ...p,
  slug: p.id,
  data: {
    ...p.data,
    cover: resolveCover('blog', p.id, p.data.cover),
  },
}));
---

<BlogLayout title={categoryName}>
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    カテゴリ：{categoryName}
    <span class="text-base font-normal text-gray-400">
      ({filtered.length} 件)
    </span>
  </h1>
  <PostList posts={postData} />
</BlogLayout>
