---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-primary mb-4">404</p>
    <h1 class="text-2xl font-bold mb-4">ページが見つかりません</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">
      お探しのページは移動または削除された可能性があります。
    </p>
    <a
      href="/"
      class="inline-block px-6 py-3 rounded-lg bg-primary text-white text-sm font-medium hover:opacity-90 transition-opacity"
    >
      ホームに戻る
    </a>
  </div>
</BaseLayout>
