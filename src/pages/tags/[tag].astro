---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { resolveCover } from '../_imageStore';
import { slugify } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags || []) {
      tags.add(tag);
    }
  }
  return Array.from(tags).map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tagName: tag },
  }));
}

const { tagName } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const filtered = allPosts
  .filter((post) => (post.data.tags || []).includes(tagName))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postData = filtered.map((p) => ({
  ...p,
  slug: p.id,
  data: {
    ...p.data,
    cover: resolveCover('blog', p.id, p.data.cover),
  },
}));
---

<BlogLayout title={tagName}>
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    タグ：{tagName}
    <span class="text-base font-normal text-gray-400">
      ({filtered.length} 件)
    </span>
  </h1>
  <PostList posts={postData} />
</BlogLayout>
